# direnv — activates the Python venv and loads .env on cd into this repo.
# See https://direnv.net/ for docs.

# Activate the Python virtual environment (created by setup.sh).
if [[ -f .venv/bin/activate ]]; then
  source .venv/bin/activate
fi

# Load variables from .env into the shell, if present.
# dotenv exports every KEY=VALUE pair into the environment.
if [[ -f .env ]]; then
  dotenv
fi

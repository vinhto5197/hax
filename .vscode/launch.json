{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: FastAPI (debugpy)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["apps.api.main:app", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Worker: Celery (debugpy)",
      "type": "debugpy",
      "request": "launch",
      "module": "celery",
      "args": [
        "-A",
        "apps.worker.celery_app",
        "worker",
        "--pool=solo",
        "--loglevel=info"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Web: Chrome (frontend)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/apps/web",
      "resolveSourceMapLocations": ["**", "!**/node_modules/**"],
      "skipFiles": ["**/node_modules/**"]
    }
  ],
  "compounds": [
    {
      "name": "Full stack (API + Web)",
      "configurations": ["API: FastAPI (debugpy)", "Web: Chrome (frontend)"],
      "stopAll": true
    },
    {
      "name": "Full stack + Worker",
      "configurations": [
        "API: FastAPI (debugpy)",
        "Web: Chrome (frontend)",
        "Worker: Celery (debugpy)"
      ],
      "stopAll": true
    }
  ]
}

DATABASE_URL=postgresql://hax:hax@localhost:5432/hax
REDIS_URL=redis://localhost:6379/0

# Dev: frontend hits FastAPI directly to avoid Next.js's dev-server proxy
# buffering SSE responses. Unset in prod (ALB does same-origin routing).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Anthropic API key — https://console.anthropic.com → API Keys → Create.
# Powers /api/chat (anthropic SDK route). Bills against API credits.
ANTHROPIC_API_KEY=
# Claude Agent SDK auth. Generate via `claude setup-token` (lasts ~1 year).
# Powers /api/chat-agent-sdk. Bills against the Max subscription.
#
# Both vars can (and should) be set at the same time. The Agent SDK's bundled
# CLI prefers ANTHROPIC_API_KEY when both are visible to it — silently routing
# Agent SDK calls through API credits. packages/core/llm/agent_client.py works
# around this by passing a scrubbed env to the subprocess (OAuth token only).
CLAUDE_CODE_OAUTH_TOKEN=

# Voyage AI embeddings — https://dashboard.voyageai.com → API Keys.
# Powers M2 RAG: embeds uploaded documents and chat queries (Anthropic has no
# embeddings API — see ADR 0007). Without it, ingestion fails and chat falls
# back to plain (non-RAG) answering.
VOYAGE_API_KEY=

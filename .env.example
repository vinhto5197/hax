# App runtime connects as the least-privilege role (subject to RLS — slice 2).
DATABASE_URL=postgresql://hax_app:hax_app@localhost:5432/hax
# Owner role for Alembic (DDL needs table ownership) and admin/inspection
# scripts that must see ALL rows (RLS applies per-role; hax bypasses in dev
# as superuser, and is the owner in prod). Never point the app at this.
MIGRATIONS_DATABASE_URL=postgresql://hax:hax@localhost:5432/hax
REDIS_URL=redis://localhost:6379/0

# Dev: frontend hits FastAPI directly to avoid Next.js's dev-server proxy
# buffering SSE responses. Unset in prod (the reverse proxy does same-origin
# routing).
NEXT_PUBLIC_API_URL=http://localhost:8000
# The origin(s) allowed to call that API cross-origin (comma-separated). Unset
# in prod: no CORS middleware is installed.
CORS_ALLOW_ORIGINS=http://localhost:3000

# Root log level for the API process (logs go to stdout).
LOG_LEVEL=INFO

# Anthropic API key — https://console.anthropic.com → API Keys → Create.
# Powers /api/chat (the agentic tool-use harness). Bills against API credits.
ANTHROPIC_API_KEY=

# Voyage AI embeddings — https://dashboard.voyageai.com → API Keys.
# Powers M2 RAG: embeds uploaded documents and chat queries (Anthropic has no
# embeddings API — see ADR 0007). Without it, ingestion fails and chat falls
# back to plain (non-RAG) answering.
VOYAGE_API_KEY=

# Object storage for uploaded files (slice 2a): S3 in prod, MinIO in dev.
# S3_ENDPOINT_URL points boto3 at local MinIO; leave it UNSET in prod to use AWS
# S3. AWS_* are MinIO's root creds in dev (match docker-compose) / IAM in prod.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=hax-documents
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=hax
AWS_SECRET_ACCESS_KEY=haxhaxhax

# Retrieval + chunking tuning knobs (slice 2b). Values below reproduce current
# behaviour; change them to tune. Not eval-tuned yet (M5).
RAG_TOP_K=5              # nearest chunks retrieved per query
# RAG_MAX_DISTANCE=      # absolute cosine-distance cutoff; unset = disabled
RAG_CHUNK_SIZE=1600      # chunk size in characters (re-ingest to take effect)
RAG_CHUNK_OVERLAP=200    # chunk overlap in characters

# LLM (chat) knobs. Haiku is a fine default for grounded RAG Q&A; switch to a
# larger model for reasoning-heavy work.
LLM_MODEL=claude-haiku-4-5
LLM_MAX_TOKENS=32000

# Model for background conversation titles (one tiny call per new conversation).
TITLE_MODEL=claude-haiku-4-5
# Background-task publishing from the API: threads that push to the broker, and
# how many publishes may wait before new ones are dropped (broker outage).
ENQUEUE_THREADS=2
ENQUEUE_MAX_PENDING=100

# Agentic route (slice 3): recipient for the MOCKED send_email tool. The tool
# logs the would-be send and returns success — it does NOT actually send (real
# Gmail is v1), so this is just the address shown in the log line.
EMAIL_RECIPIENT=you@example.com

# M2.5 auth. BOOTSTRAP_USER_EMAIL: one-time — the user the pre-auth corpus is
# assigned to during the auth migration (only consulted if legacy unowned rows
# exist). Claim the account afterwards via scripts/set_password.py (dev) or
# Google sign-in / verified signup with the same email (slice 3/4).
BOOTSTRAP_USER_EMAIL=

# Shared JWT secret — Auth.js (web) mints, FastAPI verifies. Generate:
# openssl rand -base64 32. Rotating it logs every session out.
AUTH_SECRET=
# Guards /internal/auth/* (Next server-side -> FastAPI). Different value from
# AUTH_SECRET. Generate the same way.
INTERNAL_API_SECRET=
# Google sign-in (M2.5 slice 3). OAuth client from Google Cloud Console — see
# README "Google sign-in". Auth.js reads these two names by convention.
# Leave blank to run without Google (the button then fails at Google's end).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Where Next's SERVER reaches FastAPI (authorize() runs server-side).
API_INTERNAL_URL=http://localhost:8000
# Session cookie name FastAPI reads (Auth.js default; __Secure- prefix at M3).
AUTH_COOKIE_NAME=authjs.session-token
# Login gate on email verification. ON from slice 4 (verification emails
# ship). Set false only for a throwaway local DB.
AUTH_REQUIRE_EMAIL_VERIFICATION=true

# Emails (M2.5 slice 4): verification + password-reset links. Dev sends to
# Mailpit (compose) — inbox at http://localhost:8025. Prod (M3): point at a
# real relay; set SMTP_USER/SMTP_PASSWORD to enable STARTTLS + login.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=hax@localhost
# SMTP_USER=
# SMTP_PASSWORD=
# Base URL used in emailed links (the web app's origin).
APP_BASE_URL=http://localhost:3000

# Per-process cap on concurrent argon2 ops; memory ≈ cap × 19MiB × workers.
ARGON2_MAX_CONCURRENT=4

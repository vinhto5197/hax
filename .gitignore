# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (monorepo: any app dir)
node_modules/
.pnp
.pnp.js
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-debug.log*

# testing
coverage/

# next.js
.next/
out/

# production
build/
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# local env files
.env*.local
.env
.env.*
!.env.example
.envrc

# Local-only scratch / notes files. Anything matching *.local.md stays out
# of git — useful for personal dev backlogs that aren't ready to publish.
*.local.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
.venv/
env/
*.egg-info/
*.egg
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# celery
celerybeat-schedule
celerybeat.pid
*.pid

# docker
.docker/

# claude code
.claude/

# ide
.idea/
*.swp
*.swo

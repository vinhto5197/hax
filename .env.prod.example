# Production env for the box (/opt/hax/.env): read via compose.prod.yml's
# env_file, and passed to compose itself with --env-file for SITE_ADDRESS.
# One file, but not one audience: compose blanks MIGRATIONS_DATABASE_URL for
# api/worker/web (migrate alone runs DDL) and every data/model/mail credential
# for web. Placeholders in <angle brackets>.
#
# Local production run (make prod-up): copy this file to
# infra/compose/.env.local (gitignored) and point it at the compose.prod.local.yml
# stand-ins — postgres (no sslmode), minio (S3_ENDPOINT_URL=http://minio:9000
# plus S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY=minioadmin), mailpit
# (SMTP_HOST=mailpit, SMTP_PORT=1025, no SMTP_USER) — with
# SITE_ADDRESS=localhost and https://localhost for AUTH_URL/APP_BASE_URL.

# Public hostname Caddy serves and obtains a certificate for.
SITE_ADDRESS=<domain>

# Runtime role, subject to RLS. asyncpg gets sslmode translated to ssl.
DATABASE_URL=postgresql://hax_app:<password>@<rds-endpoint>:5432/hax?sslmode=require
# Owner role for the migrate one-shot (DDL needs ownership). Never the app's.
MIGRATIONS_DATABASE_URL=postgresql://<master>:<password>@<rds-endpoint>:5432/hax?sslmode=require
# Broker + auth cache: the redis service on the compose network.
REDIS_URL=redis://redis:6379/0

# Uploads. No S3_ENDPOINT_URL and no AWS keys: boto3 uses the instance profile.
S3_BUCKET=<bucket>
S3_REGION=us-east-1

# Model providers.
ANTHROPIC_API_KEY=<key>
VOYAGE_API_KEY=<key>
LLM_MODEL=claude-haiku-4-5
TITLE_MODEL=claude-haiku-4-5

# JWT secret shared by Auth.js (mints) and FastAPI (verifies): openssl rand -base64 32.
AUTH_SECRET=<secret>
# Guards /internal/* (Next server -> FastAPI); a different value from AUTH_SECRET.
INTERNAL_API_SECRET=<secret>
# The public origin; Auth.js builds callback URLs from it.
AUTH_URL=https://<domain>
# Auth.js trusts the Host / X-Forwarded-* headers Caddy sets.
AUTH_TRUST_HOST=true
# Over https Auth.js prefixes its session cookie with __Secure-; FastAPI must
# read that exact name or every API call is 401.
AUTH_COOKIE_NAME=__Secure-authjs.session-token
# Where Next's server reaches FastAPI: the compose network, not the public origin.
API_INTERNAL_URL=http://api:8000
# Google sign-in; the OAuth client's redirect URI is https://<domain>/auth/callback/google.
AUTH_GOOGLE_ID=<client-id>
AUTH_GOOGLE_SECRET=<client-secret>
# Login requires a verified email.
AUTH_REQUIRE_EMAIL_VERIFICATION=true
# Origin used in emailed links.
APP_BASE_URL=https://<domain>

# SMTP relay; SMTP_USER set enables STARTTLS + login.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=<resend-api-key>
SMTP_FROM=noreply@<domain>

# API log level (stdout -> docker logs). The worker is pinned at info by
# compose.prod.yml: at DEBUG it would log raw exception text (addresses,
# provider replies, document content).
LOG_LEVEL=INFO
# The demo: user turns per visitor, new visitors per address per day, and how
# many days a visitor's row (and everything it owns) lives before the sweep.
DEMO_TURN_LIMIT=3
ANON_PER_IP_PER_DAY=3
ANON_RETENTION_DAYS=3
# Background-publish threads and the pending cap before publishes are dropped.
ENQUEUE_THREADS=2
ENQUEUE_MAX_PENDING=100

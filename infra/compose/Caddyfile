{$SITE_ADDRESS} {
	encode zstd gzip
	# Browsers remember to use https for a year after one visit, so the
	# plaintext first request (before Caddy's redirect) happens once, not per
	# visit. Only ever served over TLS, so the promise is always kept.
	header Strict-Transport-Security "max-age=31536000"

	# FastAPI owns /api/*. flush_interval -1: the chat SSE stream is written
	# through as it arrives, never buffered. max_size is the request-body cap
	# for the whole API: Starlette spools a multipart upload to disk BEFORE the
	# route's checks run, so this is the only hop that refuses an oversized
	# body (413) without receiving it. Must stay above the largest upload the
	# API accepts (5 MB plus multipart overhead).
	handle /api/* {
		request_body {
			max_size 6MB
		}
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	# Everything else is Next, including /auth/* (Auth.js). FastAPI's
	# /internal/* is deliberately NOT routed: Next's server reaches it over the
	# compose network (API_INTERNAL_URL), so it never needs a public path.
	handle {
		reverse_proxy web:3000
	}
}
